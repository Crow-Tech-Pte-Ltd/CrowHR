# Crow HR configuration. Copy to .env:   cp .env.example .env
# Every variable is checked at startup; a wrong value stops the app with a message saying how
# to fix it. Full reference: https://hr.crow.sg/docs/self-hosting/configuration/
# (source: apps/docs/src/content/docs/self-hosting/configuration.md)

# ============================================================================================
# Self-hosting (docker compose)
# ============================================================================================

# REQUIRED. The address people type in the browser: scheme + host (+ port), no path.
#   Behind a reverse proxy with TLS:   PUBLIC_URL=https://hr.example.sg
#   On a LAN without a proxy:          PUBLIC_URL=http://192.168.1.20:8080
# Cookie security (Secure) and links in emails come from this value, never from request headers.
PUBLIC_URL=

# Host side of the published port, and which host address it binds to.
#   Use BIND_ADDRESS=127.0.0.1 when a reverse proxy on the same machine is the only way in.
HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0

# IPs or CIDR ranges of your reverse proxy. X-Forwarded-For/-Proto/-Host are only believed from
# these addresses. Leave empty without a proxy. Shorthands: private (all private ranges, e.g. a
# proxy container on the same Docker network), loopback (only a proxy inside the app container:
# a proxy installed on the host reaches the app from the Docker gateway, so use private).
#   Caddy/nginx/Traefik in Docker on this host:  TRUSTED_PROXIES=private
#   A proxy on another machine:                  TRUSTED_PROXIES=192.168.1.5
TRUSTED_PROXIES=

# Required for scheduled backups (disabled until set). Encrypts the master key and archive; without it,
# anyone holding a backup file can read NRIC, bank and SSO data. At least 12 characters.
# Keep it somewhere safe outside this server: restores need it.
BACKUP_PASSPHRASE=

# Nightly backup time (24 h, Singapore time), or off. Number of backups kept.
BACKUP_TIME=02:00
BACKUP_KEEP=14

# --- Optional ---------------------------------------------------------------------------------
# Email (SMTP). Without it Crow HR works fully: notifications appear in the app (bell, top right)
# and invitations and password resets show a link to copy. With it, notifications are also emailed
# (each person chooses what in Settings → Notifications) and failed sends are retried for ~15 h.
# smtp:// uses STARTTLS when the server offers it (port 587); smtps:// is TLS from the start (465).
# URL-encode special characters in the password (@ → %40).
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310
# Optional private clamd service; uploads use INSTREAM via the shared background scan pipeline.

# SMTP_URL=smtps://hr%40example.sg:app-password@smtp.example.sg:465
# MAIL_FROM="Crow HR <hr@example.sg>"

# 32 random bytes (base64 or hex) that encrypt NRIC, bank numbers and MFA/SSO secrets.
# Leave empty: one is generated on first start into the data volume (/data/secrets/crowhr.key)
# and included in every backup. Set it only to manage the key yourself (openssl rand -base64 32).
# CROWHR_SECRET_KEY=

# Use an external PostgreSQL 17 instead of the bundled one.
# DATABASE_URL=postgres://crowhr:password@db.internal:5432/crowhr

# Take a backup before applying database upgrades (true/false).
# BACKUP_BEFORE_MIGRATE=true
# BACKUP_TIMEZONE=Asia/Singapore

# Seconds to wait for the database at startup; seconds to wait for another instance's migrations.
# DB_WAIT_SECONDS=60
# MIGRATE_LOCK_TIMEOUT_SECONDS=300

# Fixed first-run setup code, for scripted installs only (16 characters, e.g. ACDE-FGHJ-KMNP-QRTU).
# Normally leave unset: a random code is printed in `docker compose logs app`.
# SETUP_CODE=

# debug | info | warn | error
# LOG_LEVEL=info

# Only for hosting the public demo's Singpass login (most installs leave these unset): the id of
# this server's Singpass method and the demo sign-in page visitors return to. Both or neither.
# See https://hr.crow.sg/docs/admin/sso/singpass/#public-demo
# DEMO_SINGPASS_PROVIDER_ID=01a1c086-96f9-793c-ac3e-aef0f1f4aae5
# DEMO_SINGPASS_RETURN_URL=https://hr.crow.sg/sign-in/kopi-kaki

# Error monitoring with your own GlitchTip or Sentry project. Off (nothing loaded or sent) without
# a DSN. Events carry no request bodies, cookies, query strings, IPs or user details.
# SENTRY_DSN=https://<key>@glitchtip.example.sg/1
# Browser errors (the DSN is readable by browsers; may be the same project or a separate one):
# SENTRY_BROWSER_DSN=https://<key>@glitchtip.example.sg/2
# SENTRY_ENVIRONMENT=production
# Default release: crowhr@<version>+<commit> (commit from CROWHR_GIT_SHA when the image was built).
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_ENABLE_LOGS=true

# ============================================================================================
# Local development (bun run dev) — not used by docker compose
# ============================================================================================
# Without DATABASE_URL, development uses in-process PGlite in ./data/pglite (pglite:memory for a
# throwaway database). PUBLIC_URL defaults to http://localhost:8080, the key is generated into
# ./data/secrets, and the server listens on 127.0.0.1:8080 (Vite proxies /api there).
# DATABASE_URL=pglite:./data/pglite
# HOST=127.0.0.1
# PORT=8080
# MIGRATE_ON_START=true
