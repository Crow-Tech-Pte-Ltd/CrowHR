# Copy to .env and adjust. Every variable is validated at server startup.

# PostgreSQL connection string (production / docker-compose):
#   postgres://crowhr:crowhr@localhost:5432/crowhr
# Local development without a Postgres server (in-process PGlite):
#   pglite:memory          - throwaway, data lost on restart
#   pglite:./data/pglite   - persisted to a directory
DATABASE_URL=pglite:./data/pglite

# The address people open Crow HR at (origin only, no path). Drives cookie security, the
# CSRF check and SSO redirect URIs. Plain http is fine on a trusted LAN.
PUBLIC_URL=http://127.0.0.1:3000

# 32 random bytes (base64 or hex) that encrypt NRIC, bank numbers and MFA/SSO secrets.
# Generate with: openssl rand -base64 32   -- and back it up with your database backups:
# losing it makes that data unreadable. The server refuses a key that doesn't match the database.
CROWHR_SECRET_KEY=

# HTTP listener
HOST=127.0.0.1
PORT=3000

# Where uploaded files are stored on disk
FILE_STORAGE_DIR=./data/files

# Built web app to serve (defaults to apps/web/dist)
# WEB_DIST_DIR=../web/dist

# Apply database migrations on startup (true/false)
MIGRATE_ON_START=true

# debug | info | warn | error
LOG_LEVEL=info
