{
  "name": "@crowhr/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Crow HR documentation site (Astro Starlight), served as static files at hr.crow.sg/docs.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-dist.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check-dist": "node scripts/check-dist.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "astro": "7.4.2"
  }
}
