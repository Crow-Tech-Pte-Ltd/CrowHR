{
  "name": "@crowhr/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Crow HR Node server: serves the API and the built web app.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import ./src/instrument.ts src/main.ts",
    "start": "node --import ./src/instrument.ts src/main.ts",
    "migrate": "node src/migrate-cli.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@crowhr/core": "workspace:*",
    "@crowhr/demo": "workspace:*",
    "@electric-sql/pglite": "^0.5.13",
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "10.78.0",
    "age-encryption": "^0.3.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "tar-stream": "~3.1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/tar-stream": "3.1.4"
  }
}
