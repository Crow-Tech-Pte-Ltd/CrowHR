<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules: nothing leaves the device. Tokens, cached
  payslip lists, leave balances, the schedule and queued punches are encrypted with a
  device-bound Keystore key and would be useless elsewhere anyway (mobile-apps spec
  "Native sign-in and session storage", "Zero data collection").
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
